    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@liora/contracts": "workspace:*",
    "expo": "~53.0.22",
    "expo-router": "~5.1.11",
    "expo-camera": "~16.1.11",
    "expo-sensors": "~14.1.4",
    "expo-crypto": "~14.1.5",
    "expo-device": "~7.1.4",
    "expo-status-bar": "~2.2.3",
    "expo-splash-screen": "~0.30.10",
    "expo-linking": "~7.1.7",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-ble-plx": "^3.2.0",
    "react-native-permissions": "^5.0.0",
    "zustand": "^5.0.11",
    "zod": "^3.24.1",
    "expo-secure-store": "~14.2.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
