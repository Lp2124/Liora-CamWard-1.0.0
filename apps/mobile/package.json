{
  "name": "@liora/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:debug": "eas build --platform android --profile development",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "build:ios:preview": "eas build --platform ios --profile preview",
    "build:ios:production": "eas build --platform ios --profile production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@liora/contracts": "workspace:*",
    "expo": "~53.0.0",
    "expo-router": "~4.0.0",
    "expo-camera": "~16.0.0",
    "expo-sensors": "~14.0.0",
    "expo-location": "~18.0.0",
    "expo-crypto": "~14.0.0",
    "expo-device": "~7.0.0",
    "expo-status-bar": "~2.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-linking": "~7.0.0",
    "expo-file-system": "~18.1.11",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-ble-plx": "^3.2.0",
    "react-native-permissions": "^5.0.0",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "zustand": "^5.0.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "@types/react-native": "~0.76.0",
    "typescript": "~5.7.0",
    "eslint": "^9",
    "jest": "^29",
    "jest-expo": "~53.0.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.js",
      "**/*.test.ts",
      "**/*.test.tsx"
    ]
  }
}