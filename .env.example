DATABASE_URL=postgres://postgres:postgres@localhost:5432/liora_camward
LOG_DIR=./liora-camward

LLM_BASE_URL=
LLM_API_KEY=

# Optional external integration base URL. Leave empty when unused.
REACTUS_BASE_URL=

# Optional platform project identifier. Never place secret credentials here.
HAPPYSEEDS_PROJECT_ID=

# Authentication transaction secret. Generate at deployment; minimum 32 bytes.
AUTH_APP_TRANSACTION_SECRET=

# Optional analytics configuration.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Mobile API origin injected at build time. HTTPS is required outside localhost.
EXPO_PUBLIC_API_URL=

# Private S3-compatible evidence storage (AWS S3, MinIO, R2 S3 API, etc.).
# Keep the bucket private. Credentials belong only in deployment secrets/environment.
EVIDENCE_S3_ENDPOINT=
EVIDENCE_S3_REGION=
EVIDENCE_S3_BUCKET=
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=

# Liora CamWard — creator/admin.
# Configure real administrator identities only in deployment secrets/environment.
ADMIN_EMAILS=
ADMIN_EMAIL=

# Liora CamWard — Stripe. Configure only through deployment secrets/environment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
